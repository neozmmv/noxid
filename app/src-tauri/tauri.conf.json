{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noxid",
  "mainBinaryName": "noxid",
  "version": "0.1.0",
  "identifier": "dev.noxid.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noxid",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Noxid",
    "category": "SocialNetworking",
    "shortDescription": "Voice calls and screen sharing, peer to peer",
    "longDescription": "Noxid is a voice-first calling app for small groups, with screen sharing, connecting participants directly over iroh.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libasound2t64 | libasound2",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      }
    }
  }
}
